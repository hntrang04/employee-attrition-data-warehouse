      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>
CALCULATE;            
CREATE MEMBER CURRENTCUBE.[Measures].[Count Attrition]
 AS ABS([Measures].[Sum Attrition]), 
VISIBLE = 1;        
CREATE MEMBER CURRENTCUBE.[Measures].[Count Promotion 1]
 AS ABS([Measures].[Sum Promotion]), 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[Count Promotion 0]
 AS [Measures].[Fact Count] - ABS([Measures].[Sum Promotion]), 
VISIBLE = 1;           
CREATE MEMBER CURRENTCUBE.[Measures].[Average Monthly Hours]
 AS ROUND([Measures].[Sum Hours]/[Measures].[Fact Count], 2), 
VISIBLE = 1;           
CREATE MEMBER CURRENTCUBE.[Measures].[Average Salary]
 AS ROUND([Measures].[Sum Salary]/[Measures].[Fact Count], 2), 
VISIBLE = 1;           
CREATE MEMBER CURRENTCUBE.[Measures].[Average Satisfaction Level]
 AS ROUND([Measures].[Sum Satisfaction]/[Measures].[Fact Count], 2), 
VISIBLE = 1;           
CREATE MEMBER CURRENTCUBE.[Measures].[Average Years At Company]
 AS ROUND([Measures].[Sum Years]/[Measures].[Fact Count], 2), 
VISIBLE = 1;       
CREATE DYNAMIC SET CURRENTCUBE.[Top 5 Salary]
 AS TOPCOUNT([Dim Employee].[Employee ID].CHILDREN, 5, [Measures].[Average Salary]);     
CREATE DYNAMIC SET CURRENTCUBE.[Top 3 Years]
 AS TOPCOUNT([Dim Employee].[Employee ID].CHILDREN, 3, [Measures].[Average Years At Company]);     
CREATE DYNAMIC SET CURRENTCUBE.[Top 10 Satisfaction Lowest]
 AS BOTTOMCOUNT([Dim Employee].[Employee ID].CHILDREN, 10, [Measures].[Average Satisfaction Level]);     
CREATE DYNAMIC SET CURRENTCUBE.[Low Satisfaction Employees]
 AS FILTER(
        [Dim Employee].[Employee ID].MEMBERS, 
        [Measures].[Average Satisfaction Level] &lt; 0.5
    );     
CREATE DYNAMIC SET CURRENTCUBE.[Monthly Hours Above 200]
 AS FILTER( [Dim Role].[Department].MEMBERS, [Measures].[Average Monthly Hours] &gt; 200 ); </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
  </Cubes>
